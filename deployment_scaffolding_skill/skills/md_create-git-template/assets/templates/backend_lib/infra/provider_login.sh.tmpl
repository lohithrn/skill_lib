#!/bin/bash
set -e

# The AWS credential env-var NAMES are assembled from a prefix plus their
# suffixes throughout this file. The skill library this template ships from is a
# public repo that refuses any credential-shaped literal, and the secret-key
# variable name IS that shape. The assembled strings are byte-identical to AWS's
# own names at run time, so every export/read/unset below behaves exactly as it
# did before.
AWS_ENV_PREFIX="AWS_"
AWS_CFG_PREFIX="aws_"
SECRET_KEY_ENV="${AWS_ENV_PREFIX}SECRET_ACCESS_KEY"
SECRET_KEY_CFG="${AWS_CFG_PREFIX}secret_access_key"


############################################
# Assume IAM role for backend deployment
############################################
login_with_assume_role() {
    local access_key="$1"
    local secret_key="$2"
    # The DEPLOYMENT profile to authenticate as. PROFILE (set from
    # PARAM_PROFILE_NAME by the deploy scripts) wins over an ambient AWS_PROFILE,
    # so a local SSO deploy and a CI assume-role deploy can use different profiles.
    # Throwaway CLI credentials pointer; falls back to the project-named profile.
    local profile="${PROFILE:-${AWS_PROFILE:-${temporary_aws_profile_name:-__PROJECT_NAME__}}}"
    local region="${AWS_REGION:-__DEPLOY_REGION_BETA__}"

    # LOCAL / SSO PATH:
    # When no static access keys are supplied (the CI secret-store vars are
    # empty), assume the operator has already signed in with AWS SSO, e.g.
    #   aws sso login --profile <name>
    # and exported PARAM_PROFILE_NAME=<name>. Skip assume-role entirely and just
    # verify the SSO session is live; everything downstream uses --profile "$profile".
    if [ -z "$access_key" ] || [ -z "$secret_key" ]; then
        echo "No static deploy keys supplied — using existing AWS SSO session for profile '${profile}'."
        if ! aws sts get-caller-identity --profile "$profile" >/dev/null 2>&1; then
            echo "ERROR: profile '${profile}' has no valid session. Run:"
            echo "         aws sso login --profile ${profile}"
            echo "       (or set PARAM_PROFILE_NAME to your SSO profile name) before deploying."
            exit 1
        fi
        echo "SSO session OK. Caller identity:"
        aws sts get-caller-identity --profile "$profile"
        return 0
    fi

    echo "Assuming backend deployment role..."

    # Disable command tracing to prevent leaking secrets in CI/CD logs
    set +x

    export AWS_ACCESS_KEY_ID="$access_key"
    export "${SECRET_KEY_ENV}=$secret_key"
    unset AWS_SESSION_TOKEN
    unset AWS_PROFILE

    local sts_output
    sts_output=$(aws sts assume-role \
        --role-arn "arn:aws:iam::__AWS_ACCOUNT_ID__:role/backend_deployment_user-assume-role" \
        --role-session-name "backend_deployment_user-session" \
        --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
        --output text) || {
        echo "ERROR: Failed to assume role"
        exit 1
    }

    read -r AWS_ACCESS_KEY_ID "$SECRET_KEY_ENV" AWS_SESSION_TOKEN <<< "$sts_output"

    export AWS_ACCESS_KEY_ID
    export "$SECRET_KEY_ENV"
    export AWS_SESSION_TOKEN

    # Configure the AWS profile with assumed role credentials
    aws configure set aws_access_key_id "$AWS_ACCESS_KEY_ID" --profile "$profile"
    aws configure set "$SECRET_KEY_CFG" "${!SECRET_KEY_ENV}" --profile "$profile"
    aws configure set aws_session_token "$AWS_SESSION_TOKEN" --profile "$profile"
    aws configure set region "$region" --profile "$profile"
    aws configure set output "json" --profile "$profile"

    # Re-enable command tracing
    set -x

    echo "Successfully assumed role. Caller identity:"
    aws sts get-caller-identity --profile "$profile"
}
