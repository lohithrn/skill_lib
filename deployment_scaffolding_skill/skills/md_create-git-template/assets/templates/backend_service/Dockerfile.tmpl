# =============================================================================
# __PROJECT_NAME__ — service container image (SKELETON).
#
# Minimal Python service image. Build + push to ECR (__ECR_REPO_NAME__) happens
# in build_service_artifact() (infra/deploy_utils.sh); the image URI is then
# handed to terraform as var.service_image_uri. Fill in your real dependencies,
# source copy, port, and entrypoint.
# =============================================================================
FROM --platform=linux/amd64 python:3.12-slim AS production

# Non-root runtime user.
RUN addgroup --gid 1001 appuser && adduser --uid 1001 --gid 1001 --disabled-password --gecos "" appuser

WORKDIR /app

# Install Python dependencies.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the service source (adjust to your layout, e.g. src/).
COPY src/ ./src/

# The port your service listens on.
EXPOSE 8080

USER 1001

# Replace with your real entrypoint (e.g. uvicorn/gunicorn for a FastAPI app).
ENTRYPOINT ["python", "-m", "src"]
