#!/bin/bash
set -e

# Branding/display tenant for the LOCAL dev server only. This names nothing
# persisted — it just feeds VITE_TENANT. (Distinct from deployment_tenant_profile,
# which names persisted resources in the deploy scripts.)
TENANT_NAME="${TENANT_NAME:-__TENANT_NAME__}"

echo "▸ Generating local configuration for LOCAL environment..."

cat <<EOF > .env
# Auto-generated by z_run_locally.sh
VITE_STAGE=local
VITE_TENANT=${TENANT_NAME}
VITE_PRODUCTION=false
VITE_SITE_URL=http://localhost:5173
EOF

echo "▸ Local configuration generated successfully."

# Check if nvm is available
if command -v nvm &> /dev/null; then
    nvm use 18 || nvm use stable
fi

# Start local Vite dev server
npm run dev
