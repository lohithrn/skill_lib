#!/bin/bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Generic service deploy helpers: package the service artifact, ensure the
# terraform S3 backend, and run terraform init/plan/apply.
#
# TWO DISTINCT IDENTITIES flow through here — do NOT conflate them:
#
#   1. THROWAWAY CLI PROFILE (temporary_aws_profile_name / $profile / --profile) —
#      the credentials pointer the AWS CLI + terraform are forced to name. Value =
#      ${PROJECT_NAME}; the assumed-role session is written into it. It is created
#      /deleted, may change run-to-run, and MUST NEVER name a persisted resource.
#      (The SSO/login SOURCE identity is PROFILE — see provider_login.sh.)
#
#   2. PERSISTED-RESOURCE IDENTITY (deployment_tenant_profile) — the ONE identity
#      that names every persisted resource: the terraform state bucket
#      (terraform-<env>-<deployment_tenant_profile>-state) AND the lowercased
#      SUFFIX on every terraform resource name. Must NOT depend on the CLI profile
#      so local + CI share one state. HAS NO DEFAULT — empty/unset fails loudly.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Initialize common variables
init_deployment_vars() {
    local profile=$1
    local environment=$2
    local region=$3

    # Get project name from directory name — this is the single source of truth for
    # the service name. It flows into the tfvars `project_name`/`prefix`. NEVER
    # hardcode the service name anywhere.
    PROJECT_NAME=$(basename $(pwd))

    echo "Deploying project: ${PROJECT_NAME}"
    echo "Environment: ${environment}"
    echo "AWS Profile: ${profile}"
    echo "AWS Region: ${region}"

    # Create temporary directory for Terraform files
    TEMP_TF_PATH="$(pwd)/infra/terraform/.terraform"
    LOCAL_TF_PLAN="${TEMP_TF_PATH}/${PROJECT_NAME}_${environment}.tfplan"
    mkdir -p $TEMP_TF_PATH
}

# Create and configure the S3 backend bucket (versioned, encrypted, private).
setup_terraform_backend() {
    local profile=$1
    local region=$2
    local backend_bucket=$3

    echo "DEBUG: Attempting to access bucket: ${backend_bucket}"
    echo "DEBUG: Using AWS Profile: ${profile}"
    echo "DEBUG: Using Region: ${region}"

    if ! aws s3 ls "s3://${backend_bucket}" --profile "${profile}" --region "${region}" 2>/dev/null; then
        echo "Failed to access bucket ${backend_bucket}"
        bucket_check=1
    else
        bucket_check=0
    fi
    echo "DEBUG: Bucket check exit code: ${bucket_check}"

    if [ $bucket_check -eq 0 ]; then
        echo "Using existing S3 backend bucket: ${backend_bucket}"
    else
        echo "Creating new S3 backend bucket: ${backend_bucket}"
        if ! aws s3api create-bucket \
            --bucket "${backend_bucket}" \
            --profile "${profile}" \
            --region "${region}" \
            $([ "${region}" != "us-east-1" ] && echo "--create-bucket-configuration LocationConstraint=${region}") ; then
            echo "Failed to create S3 bucket"
            exit 1
        fi

        # Enable versioning
        aws s3api put-bucket-versioning \
            --bucket "${backend_bucket}" \
            --profile "${profile}" \
            --versioning-configuration Status=Enabled

        # Enable encryption
        aws s3api put-bucket-encryption \
            --bucket "${backend_bucket}" \
            --profile "${profile}" \
            --server-side-encryption-configuration '{
                "Rules": [
                    {
                        "ApplyServerSideEncryptionByDefault": {
                            "SSEAlgorithm": "AES256"
                        }
                    }
                ]
            }'

        # Block public access
        aws s3api put-public-access-block \
            --bucket "${backend_bucket}" \
            --profile "${profile}" \
            --public-access-block-configuration '{
                "BlockPublicAcls": true,
                "IgnorePublicAcls": true,
                "BlockPublicPolicy": true,
                "RestrictPublicBuckets": true
            }'

        echo "Successfully created and configured S3 backend bucket"
    fi

    echo "${backend_bucket}"
}

# Create the terraform vars file. The core variables every service needs, all
# derived from the folder name / deploy environment / deploy-time config —
# NOTHING is hardcoded. Add service-specific vars here as your compute grows.
create_tfvars() {
    local profile=$1
    local environment=$2
    local region=$3
    local tfvars_path=$4

    {
        echo "project_name = \"${PROJECT_NAME}\""
        echo "environment = \"${environment}\""
        echo "aws_profile = \"${profile}\""
        echo "aws_region = \"${region}\""
        echo "prefix = \"${environment}_${PROJECT_NAME}\""
        # deployment_tenant_profile is the ONE identity naming persisted resources:
        # it is the lowercased SUFFIX appended to every terraform resource name (and
        # names the state bucket). Set by the z_setup_deploy_* scripts; validated
        # non-empty in deploy() before we get here; never hardcoded in TF.
        echo "deployment_tenant_profile = \"${deployment_tenant_profile}\""
        # The container image URI to deploy, if this service is containerized
        # (ECR). Empty is fine for a Lambda-zip service. Populated by the deploy
        # scripts (SERVICE_IMAGE_URI) once you push an image.
        [ -n "${SERVICE_IMAGE_URI:-}" ] && echo "service_image_uri = \"${SERVICE_IMAGE_URI}\""
    } > "$tfvars_path"

    return 0
}

# Run terraform init, refresh, plan, and apply. terraform apply is the deploy's
# source of truth for success — its exit status is captured and propagated so a
# failed apply can NEVER be reported as a successful deploy.
run_terraform() {
    local profile=$1
    local environment=$2
    local region=$3
    local tfvars_path=$4
    local plan_path=$5
    local backend_bucket=$6

    cd infra/terraform

    echo "DEBUG: Initializing Terraform with backend config:"
    echo "  Region: ${region}"
    echo "  Key: ${PROJECT_NAME}/${environment}/terraform.tfstate"
    echo "  Profile: ${profile}"
    echo "  Bucket: ${backend_bucket}"

    echo "===== Starting Terraform Init ====="
    # The S3 backend authenticates from the throwaway CLI profile via
    # -backend-config=profile. This is a credentials pointer only; the bucket/key
    # are deployment_tenant_profile / project based, so state never drifts between
    # local and CI.
    terraform init -reconfigure \
        -backend-config="bucket=${backend_bucket}" \
        -backend-config="region=${region}" \
        -backend-config="key=${PROJECT_NAME}/${environment}/terraform.tfstate" \
        -backend-config="profile=${profile}"

    echo "===== Refreshing Terraform State ====="
    terraform refresh -var-file=$tfvars_path -lock=false

    echo "===== Listing Terraform State ====="
    terraform state list

    echo "===== Starting Terraform Plan ====="
    if ! terraform plan \
        -var-file=$tfvars_path \
        -out=$plan_path \
        -lock=false \
        -input=false; then
        echo "Terraform plan failed. Please check the errors above."
        exit 1
    fi

    echo "===== Starting Terraform Apply ====="
    # Capture apply's status EXPLICITLY and evaluate it before anything else runs.
    # A non-zero status must fail the whole deploy; no later step (post-apply
    # refresh/output, EXIT-trap cleanup, or a caller's trailing command) may mask it.
    terraform apply -lock=false $plan_path
    local apply_status=$?
    if [ "$apply_status" -ne 0 ]; then
        echo "Terraform apply FAILED (exit ${apply_status}). Aborting deploy — NOT declaring success."
        cd ../..
        return "$apply_status"
    fi
    echo "Terraform apply succeeded (exit 0)."

    echo "===== Fetching Outputs ====="
    # Best-effort: a post-apply refresh/output hiccup must NOT flip a SUCCESSFUL
    # apply into a failed deploy (the infra is already applied).
    terraform refresh -var-file=$tfvars_path || echo "WARN: post-apply refresh failed (apply already succeeded)."
    terraform output > "../terraform_outputs_${environment}.txt" || echo "WARN: terraform output dump failed (apply already succeeded)."

    cd ../..
    return 0
}

# Build the deployable service artifact.
#
# This is a SKELETON. A deployed Python service is packaged one of two ways —
# pick the one your terraform compute uses and delete the other:
#
#   (A) CONTAINER IMAGE (ECS / App Runner / Lambda-container):
#       build the image, push to ECR, and export SERVICE_IMAGE_URI so create_tfvars
#       hands it to terraform. Sketch:
#           local registry="${AWS_ACCOUNT_ID}.dkr.ecr.${region}.amazonaws.com"
#           aws ecr get-login-password --region "$region" --profile "$profile" \
#               | docker login --username AWS --password-stdin "$registry"
#           docker build --platform linux/amd64 -t "${ECR_REPO_NAME}:${environment}" .
#           docker tag  "${ECR_REPO_NAME}:${environment}" "${registry}/${ECR_REPO_NAME}:${environment}"
#           docker push "${registry}/${ECR_REPO_NAME}:${environment}"
#           export SERVICE_IMAGE_URI="${registry}/${ECR_REPO_NAME}:${environment}"
#
#   (B) LAMBDA ZIP:
#       rsync src/ + pip install (linux wheels) into a temp dir, zip it to
#       lambda_package.zip at the repo root (terraform reads it via
#       filebase64sha256(${path.module}/../../lambda_package.zip)).
#
# Left as a no-op placeholder so the deploy flow runs end-to-end before you add
# your compute. Replace with (A) or (B).
build_service_artifact() {
    local environment=$1
    echo "TODO: build the service artifact for '${environment}' (container image → ECR, or lambda zip)."
    echo "      See build_service_artifact() in infra/deploy_utils.sh — this is a skeleton no-op."
}

# Main deployment function
deploy() {
    local profile=$1
    local environment=$2
    local region=$3

    # Build the deployable artifact first (see build_service_artifact skeleton).
    build_service_artifact "$environment"

    init_deployment_vars "$profile" "$environment" "$region"

    # Create the backend bucket name.
    #
    # NOTE: the throwaway CLI profile ("$profile" / --profile / temporary_aws_profile_name,
    # = ${PROJECT_NAME}) is a credentials pointer only and DIFFERENT from the
    # persisted-resource identity used to name shared resources. The terraform state
    # bucket is shared by ALL deploys of this environment (CI + local), so its name
    # must NOT depend on the CLI profile. deployment_tenant_profile keeps local and
    # CI on one state; lowercased because S3 bucket names must be.
    #
    # CRITICAL — NO DEFAULT. deployment_tenant_profile names PERSISTED resources
    # (state bucket + every resource-name suffix); a silent fallback would risk
    # colliding or orphaning another tenant's resources. Fail loudly here, before
    # any AWS action, if it is empty/unset.
    if [ -z "${deployment_tenant_profile:-}" ]; then
        echo "ERROR: deployment_tenant_profile is not set — it names all persisted resources (state bucket + resource-name suffix) and has NO default." >&2
        echo "       Set it in z_setup_deploy_*.sh (token __DEPLOYMENT_TENANT_PROFILE__) before deploying." >&2
        exit 1
    fi
    local deployment_tenant_profile_lc
    deployment_tenant_profile_lc="$(echo "${deployment_tenant_profile}" | tr '[:upper:]' '[:lower:]')"
    local BACKEND_BUCKET="terraform-${environment}-${deployment_tenant_profile_lc}-state"

    echo "DEBUG: Created backend bucket name: ${BACKEND_BUCKET}"

    # Setup S3 backend bucket
    setup_terraform_backend "$profile" "$region" "$BACKEND_BUCKET"

    echo "DEBUG: Backend bucket being passed to run_terraform: ${BACKEND_BUCKET}"

    TFVARS_FILE="${TEMP_TF_PATH}/terraform.tfvars"

    # Clean up the tfvars + the terraform output dump on ANY exit — success,
    # failure, or interrupt — so nothing lingers on a reused build agent. Built
    # with ABSOLUTE paths expanded NOW (run_terraform exits while cwd is
    # infra/terraform, and the EXIT trap fires after deploy() has returned).
    local repo_root; repo_root="$(pwd)"
    trap "rm -f '${TFVARS_FILE}' ${repo_root}/infra/terraform_outputs_*.txt" EXIT INT TERM

    create_tfvars "$profile" "$environment" "$region" "$TFVARS_FILE"

    # Propagate run_terraform's status EXPLICITLY (= terraform apply's status) so
    # the sourcing z_setup_deploy_* script fails when apply failed.
    run_terraform "$profile" "$environment" "$region" "$TFVARS_FILE" "$LOCAL_TF_PLAN" "$BACKEND_BUCKET"
    local deploy_status=$?
    if [ "$deploy_status" -ne 0 ]; then
        echo "Deploy FAILED: terraform apply returned ${deploy_status}."
        return "$deploy_status"
    fi
    return 0
}
